;@puzzle
;@title Order three values
;@goal Arrange the default stack from top to bottom as 3, 2, 1.
;@hints 1
;@tags shuffle
;@difficulty 1
;@solution rot guess
;@wrong swap guess
;@description
; The stack panel displays the top value first.
; Use stack operations to reorder the three starting values; the idea is to rearrange them, not replace them.
; Run `guess` to validate your solution.
;@enddescription
;@end

; Rearrange the default stack at the prompt, then run guess:
;
;     rot guess

"include/std.bo" require
"examples/puzzles/lib.bo" require

((1 2 3)) (puzzle.solution) PUSH
(puzzle.solution) LOCK

() (snapshot puzzle.solution =) puzzle.require
3 1 2
("rot moves the third value from the top to the top.") (puzzle.hints) PUSH
"rot guess" (puzzle.reveal) PUSH
