"../include/std.bo" require

;Small public helpers shared by the examples. Load with:  "examples/lib.bo" require
;(kept out of the standard library on purpose: it only holds the core library ops)

;range ( a b -- L ) the list a, a+1, ... b-1
    (1 - :)
    (range)
PUSH

;incr ( key -- ) add 1 to the number kept in the stack key (1 when it is empty)
;the stack key is left untouched when it does not hold a number
    (
        (dup size 0 >)
        (dup get 1 + swap set)
        (1 swap set)
    ifte
    )
    (incr)
PUSH
