"../include/std.bo" require

;Bobo, the Bo mascot (a blue-footed booby), drawn as text.
;It defines two ops, bobo (the big picture) and bobo.mini (a 5-line one), and shows the big one.
;Another program can include this file and call either whenever it likes.
;
;The big picture is run-length encoded: each (n k) is a run of n copies of
;the k-th character of the palette. Every source line is one line of the picture;
;the run (1 4) ends it.

;the palette: k = 0 is a space, 1 the outline, 2 the wing, 3 the feet and beak, 4 a newline
    (" #%~
")
    (palette)
PUSH

;n k run : write n copies of the character k of the palette
    (
    palette swap 1 + nth apply
        (over 0 >)
        (dup emitc swap 1 - swap)
    loop 2drop
    )
    (run)
PUSH

;( run run ... ) draw : write the picture made of the runs
    ((apply lambda run) foreach)
    (draw)
PUSH

;bobo : write the big picture (the list of runs is pushed, then drawn)
