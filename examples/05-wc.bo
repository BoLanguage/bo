"../include/std.bo" require

;wc: count lines, words and characters read from standard input.

;Named stacks serve as variables: (NAME) incr adds one, (NAME) set assigns,
;and naming a stack that holds a number pushes it.

0 (lines) PUSH 0 (nwords) PUSH 0 (chars) PUSH 0 (inword) PUSH

;count : update the counters for one character code
    (
        (dup 10 =)
        ((lines) incr)
    ift
    (chars) incr
    unit (9 10 13 32) in
        ()
        (0 (inword) set)
        (
            (inword 0 =) 
            ((nwords) incr) 
        ift 
        1 (inword) set
        )
    ifte
    )
    (count)
PUSH

;read until end of file (read returns -1)
    (
        (stdin read dup -1 \=) 
        (count) 
    loop 
    drop
    )
    (readall)
PUSH

readall
lines emit 32 emitc nwords emit 32 emitc chars emit nl
