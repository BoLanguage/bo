"stack.bo" require
"logic.bo" require

;dip ( .. x q -- .. x ) run q with x set aside, then put x back on top (also after an error in q)

    (
    swap (__dip) PUSH
    () (apply) (rethrow) ((__dip) POP)
    call
    )
    (dip)
PUSH

;try ( .. T H -- .. ) run T; if it raises an error, put the default stack back as it was before T (with the values T took), push the error and run H; unlike catch, H never sees what T left half done. Only the default stack is restored: named stacks, output and other effects of T stay

    (
    (__tryh) PUSH (__tryt) PUSH
    () SNAPSHOT (__trys) PUSH
    ((__tryt) TOP apply __tryok) (__tryfail) catch
    )
    (try)
PUSH

;__tryok: T succeeded, discard the saved state

    ((__tryh) POP drop (__tryt) POP drop (__trys) POP drop)
    (__tryok)
PUSH

;__tryfail: T failed with error E: restore the saved stack, then run H on E (E --)

    (
    (__trye) PUSH
    () CLEAR (__trys) POP apply
    (__tryt) POP drop (__trye) POP (__tryh) POP apply
    )
    (__tryfail)
PUSH

;keep ( .. x q -- .. x ) run q on x, then put back a copy of x on top

    (over swap dip)
    (keep)
PUSH

;bi ( .. x p q -- .. ) run p on x, then q on another copy of x

    ((keep) dip apply)
    (bi)
PUSH

;times ( .. q n -- .. ) run q n times (not at all if n is not positive); q sees the stack below its arguments

    (
    (__times) PUSH (__timesq) PUSH
    ()
        (
            ((__times) TOP 0 >)
            ((__times) POP 1 - (__times) PUSH (__timesq) TOP apply)
        loop
        )
    (rethrow)
    ((__times) POP drop (__timesq) POP drop)
    call
    )
    (times)
PUSH

;branch ( b t e -- ) run t if b is true (positive), e otherwise: ifte with a truth value already on the stack, as in Joy

    (rot unit -rot ifte)
    (branch)
PUSH

;when ( b q -- ) run q if b is true (positive)

    (() branch)
    (when)
PUSH

;unless ( b q -- ) run q unless b is true (positive)

    (() swap branch)
    (unless)
PUSH
