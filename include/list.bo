"stack.bo" require
"logic.bo" require

;null ( -- L ) the empty list

    (())
    (null)
PUSH

;append ( a b -- L ) concatenate list a followed by list b

    (
        (dup null =)
        (drop)
        (
        unconsl rot swap consr swap append
        )
    ifte
    )
    (append)
PUSH

;prepend ( a b -- L ) the elements of b followed by those of a

    (swap append)
    (prepend)
PUSH

;foldl ( L b q -- r ) fold from the left: q receives the accumulator and a unit containing each element, with the caller's stack below

    (rot swap foreach)
    (foldl)
PUSH

;foldr ( L b q -- r ) fold from the right: q receives a unit containing each element and the accumulator, last element first, with the caller's stack below

    ((swap) swap append rot reverse swap foreach)
    (foldr)
PUSH

;__unfold: run stop and step on the seed, adding each new seed to the list in __itr with the program in __itq (L b stop step q -- L')

    (
    (__itq) PUSH (__itp) PUSH (__its) PUSH swap (__itr) PUSH
    ()
        (
            ((__its) TOP apply not)
            ((__itp) TOP apply dup unit (__itr) TOP swap (__itq) TOP apply (__itr) POP drop (__itr) PUSH)
        loop
        drop (__itr) TOP
        )
    (rethrow)
    ((__itq) POP drop (__itp) POP drop (__its) POP drop (__itr) POP drop)
    call
    )
    (__unfold)
PUSH

;unfoldl ( L b stop step -- L' ) until the program stop, run on the seed b, leaves a true value: b becomes step applied to b, and the new b is added to the left of L; stop and step see the caller's stack below the seed

    ((consl) __unfold)
    (unfoldl)
PUSH

;unfoldr ( L b stop step -- L' ) like unfoldl, but the new values are added to the right of L

    ((consr) __unfold)
    (unfoldr)
PUSH

;__lenacc: count the elements of L on top of n

    (
        (dup null =)
        (drop)
        (unconsl drop swap 1 + swap __lenacc)
    ifte
    )
    (__lenacc)
PUSH

;len ( L -- n ) the number of elements of L

    (0 swap __lenacc)
    (len)
PUSH

;nth ( L n -- u ) a unit containing the n-th element of L, counting from 1

    (
        (dup 1 =)
        (drop unconsl nip)
        (1 - swap unconsl drop swap nth)
    ifte
    )
    (nth)
PUSH

;__next: move the first element of the list in __itl to the top of the stack ( -- u)
;the list is read before it is replaced, so a value that is not a list fails with __itl intact

    ((__itl) TOP unconsl swap (__itl) POP drop (__itl) PUSH)
    (__next)
PUSH

;map ( L q -- L' ) apply q to a unit containing each element, with the caller's stack below
;q returns a unit containing the replacement

    (
    (__itq) PUSH (__itl) PUSH null (__itr) PUSH
    ()
        (
            ((__itl) TOP null \=)
            (__next (__itq) TOP apply (__itr) TOP swap consr (__itr) POP drop (__itr) PUSH)
        loop
        (__itr) TOP
        )
    (rethrow)
    ((__itl) POP drop (__itq) POP drop (__itr) POP drop)
    call
    )
    (map)
PUSH

;foreach ( L q -- ) run q for each element of L, with a unit containing the element on top of the stack and the caller's stack below

    (
    (__itq) PUSH (__itl) PUSH
    ()
        (
            ((__itl) TOP null \=)
            (__next (__itq) TOP apply)
        loop
        )
    (rethrow)
    ((__itl) POP drop (__itq) POP drop)
    call
    )
    (foreach)
PUSH

;__splitacc: helper of split that moves n elements onto an accumulator

    (
        (dup 0 =)
        (drop)
        (
        1 - ; (A L n -- A L n-1)
        swap ; A n-1 L
        unconsl ; A n-1 L' a
        3 roll ; n-1 L' a A
        swap ; n-1 L' A a
        consr ; n-1 L' A'
        -rot ; A' n-1 L'
        swap ; A' L' n-1
        __splitacc
        )
    ifte
    )
    (__splitacc)
PUSH

;split ( L n -- a b ) a holds the first n elements of L, b the rest

    (null -rot __splitacc)
    (split)
PUSH

;sel ( L n -- L' u ) remove the n-th element of L, leaving the rest and a unit containing the element

    (1 - split unconsl -rot append swap)
    (sel)
PUSH

;ins ( L u n -- L' ) insert the element of unit u so that it becomes the n-th element

    (
    rot swap 1 - split rot consl append
    )
    (ins)
PUSH

;in ( u L -- 0|1 ) 1 if the element of unit u is an element of L

    (
    over unittype drop
        (dup null =)
        (drop drop 0)
        (unconsl 2 pick = () (drop drop 1) (in) ifte)
    ifte
    )
    (in)
PUSH

;zip ( A B -- C ) pair corresponding elements of A and B, stopping at the shorter list

    (
        (dup null =)
        (2drop null)
        (
            (over null =)
            (2drop null)
            (
            swap unconsl rot unconsl rot swap
            null rot consr swap consr
            -rot zip swap unit consl
            )
        ifte
        )
    ifte
    )
    (zip)
PUSH

;mask ( L M -- L' ) the elements of L at the positions where the mask M is true (positive), in order; it stops at the shorter list

    (zip null (apply unconsl swap apply () (consr) (drop) ifte) foldl)
    (mask)
PUSH

;__test: run the program in __itq on a copy of the first element of the list in __itl, then take the element out ( -- u b)

    ((__itl) TOP unconsl nip (__itq) TOP apply __next swap)
    (__test)
PUSH

;filter ( L p -- L' ) the elements of L for which p, applied to a unit containing the element with the caller's stack below, leaves a true value

    (
    (__itq) PUSH (__itl) PUSH null (__itr) PUSH
    ()
        (
            ((__itl) TOP null \=)
            (__test () ((__itr) POP swap consr (__itr) PUSH) (drop) ifte)
        loop
        (__itr) TOP
        )
    (rethrow)
    ((__itl) POP drop (__itq) POP drop (__itr) POP drop)
    call
    )
    (filter)
PUSH

;startswith ( L P -- 0|1 ) 1 if L begins with the elements of P (a string is a list of character codes)

    (over len over len < () (2drop 0) (swap over len split drop =) ifte)
    (startswith)
PUSH

;endswith ( L P -- 0|1 ) 1 if L ends with the elements of P

    (over len over len < () (2drop 0) (over len over len - rot swap split nip =) ifte)
    (endswith)
PUSH

;contains ( L P -- 0|1 ) 1 if the elements of P occur in L next to each other, in that order

    (
    over len over len <
    () (2drop 0)
    (2dup startswith () (2drop 1) (swap unconsl drop swap contains) ifte)
    ifte
    )
    (contains)
PUSH

;__reverseacc: helper of reverse
    (
        (dup null =)
        (drop)
        (unconsr rot swap consr swap __reverseacc)
    ifte
    )
    (__reverseacc)
PUSH

;reverse ( L -- L' ) the elements of L in reverse order
    (null swap __reverseacc)
    (reverse)
PUSH

;sum ( L -- n ) the sum of the numbers in L (0 for the empty list)

    (0 (apply +) foldl)
    (sum)
PUSH

;product ( L -- n ) the product of the numbers in L (1 for the empty list)

    (1 (apply *) foldl)
    (product)
PUSH

;__take: move the first element of the run in the stack selected by K to the end of the merged run in __mz (K -- )

    (dup POP unconsl swap rot PUSH (__mz) POP swap consr (__mz) PUSH)
    (__take)
PUSH

;__merge: merge the runs in __mx and __my into __mz with the comparison in __sortq, then add __mz to the runs in __mr

    (
        ((__mx) TOP null \= (__my) TOP null \= and)
        (
        (__mx) TOP unconsl nip apply (__my) TOP unconsl nip apply (__sortq) TOP apply
        () ((__mx) __take) ((__my) __take) ifte
        )
    loop
    (__mz) POP (__mx) POP append (__my) POP append unit
    (__mr) POP swap consr (__mr) PUSH
    null (__mx) PUSH null (__my) PUSH null (__mz) PUSH
    )
    (__merge)
PUSH

;__several: whether the list L has at least two elements, without counting them all (L -- b)

    ((dup null =) (drop 0) (unconsl drop null \=) ifte)
    (__several)
PUSH

;__pass: merge the runs in __mn two by two into __mr, keeping a last odd run as it is

    (
        ((__mn) TOP __several)
        (
        (__mn) POP unconsl apply (__mx) POP drop (__mx) PUSH unconsl apply (__my) POP drop (__my) PUSH (__mn) PUSH
        __merge
        )
    loop
    (__mn) POP (__mr) POP swap append (__mr) PUSH null (__mn) PUSH
    )
    (__pass)
PUSH

;sortby ( L q -- L' ) the elements of L sorted by q ( a b -- 0|1 ), true when a may come before b, with the caller's stack below; equal elements keep their order (merge sort)

    (
    (__sortq) PUSH (unit) map (__mn) PUSH null (__mr) PUSH null (__mx) PUSH null (__my) PUSH null (__mz) PUSH
    ()
        (
            ((__mn) TOP __several)
            (__pass (__mr) POP (__mn) POP drop (__mn) PUSH null (__mr) PUSH)
        loop
        (__mn) TOP (dup null =) () (1 nth apply) ifte
        )
    (rethrow)
    ((__sortq) POP drop (__mn) POP drop (__mr) POP drop (__mx) POP drop (__my) POP drop (__mz) POP drop)
    call
    )
    (sortby)
PUSH

;sort ( L -- L' ) the numbers of L in increasing order

    ((<=) sortby)
    (sort)
PUSH

;rotate ( L n -- L' ) L rotated left by n places (right if n is negative)

    (
        (over null =)
        (drop)
        (over len mod split swap append)
    ifte
    )
    (rotate)
PUSH

;unique ( L -- L' ) the elements of L without repetitions, each where it first occurs

    (null ((2dup swap in) (drop) (consr) ifte) foldl)
    (unique)
PUSH

;__flushrun: add the current run in __itc to the runs in __itr unless it is empty, and start a new one

    (
    (__itc) POP
        (dup null =)
        (drop)
        ((__itr) POP swap unit consr (__itr) PUSH)
    ifte
    null (__itc) PUSH
    )
    (__flushrun)
PUSH

;partition ( L p -- G ) the runs of consecutive elements of L for which p, applied to a unit containing the element with the caller's stack below, leaves a true value; the other elements separate the runs and are dropped

    (
    (__itq) PUSH (__itl) PUSH null (__itr) PUSH null (__itc) PUSH
    ()
        (
            ((__itl) TOP null \=)
            (__test () ((__itc) POP swap consr (__itc) PUSH) (drop __flushrun) ifte)
        loop
        __flushrun (__itr) TOP
        )
    (rethrow)
    ((__itl) POP drop (__itq) POP drop (__itr) POP drop (__itc) POP drop)
    call
    )
    (partition)
PUSH

;pair ( a b -- L ) the two-element list (a b)

    (unit swap unit swap append)
    (pair)
PUSH

;zipwith ( A B q -- C ) apply q to units containing the corresponding elements of A and B, stopping at the shorter list, with the caller's stack below; q returns a unit containing the result, as with map

    (-rot zip swap (apply unconsl swap) swap append map)
    (zipwith)
PUSH

;groupby ( L q -- G ) the runs of consecutive elements of L in which q ( a b -- 0|1 ), run with the caller's stack below, is true for every element b and the one a before it; every element is kept

    (
    (__itq) PUSH (__itl) PUSH null (__itr) PUSH null (__itc) PUSH
    ()
        (
            ((__itl) TOP null \=)
            (
            __next
                ((__itc) TOP null =)
                ()
                ((__itc) TOP unconsr nip apply over apply (__itq) TOP apply () () (__flushrun) ifte)
            ifte
            (__itc) TOP swap consr (__itc) POP drop (__itc) PUSH
            )
        loop
        __flushrun (__itr) TOP
        )
    (rethrow)
    ((__itl) POP drop (__itq) POP drop (__itr) POP drop (__itc) POP drop)
    call
    )
    (groupby)
PUSH

;group ( L -- G ) the runs of consecutive equal elements of L, as in Haskell: (1 1 2 1) gives ((1 1) (2) (1)); sort first to gather all equal elements

    ((=) groupby)
    (group)
PUSH
