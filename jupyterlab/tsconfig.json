    "declaration": true,
    "esModuleInterop": true,
    "module": "es2020",
    "moduleResolution": "bundler",
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2020"
  },
  "include": ["src/**/*.ts"]
}
