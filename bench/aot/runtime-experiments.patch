+#ifdef BO_AOT_TRANSLATED
+static int aot_bind(Machine *m, size_t index, Val definition, const char *kinds,
+                    int (*execute)(Machine *, AotBlock *, size_t)) {
+    if (index >= m->aot_count || !is_list(definition) || !execute) return 0;
+    AotBlock *block = &m->aot_blocks[index];
+    if (block->definition) return 0;
+    List *list = as_list(definition);
+    if (list->aot_entry) return 0;
+    if (strlen(kinds) != list->len) return 0;
+    for (size_t i = 0; i < list->len; i++) {
+        int matches = kinds[i] == 'w' ? is_word(list->items[i]) :
+                      kinds[i] == 'l' ? is_list(list->items[i]) :
+                      kinds[i] == 'n' && is_num(list->items[i]);
+        if (!matches) return 0;
+    }
+    block->sites = calloc(list->len ? list->len : 1, sizeof(Stack *));
+    if (!block->sites) {
+        fputs("AOT experiment: cannot allocate call sites\n", stderr);
+        exit(2);
+    }
+    block->definition = definition;
+    block->execute = execute;
+    for (size_t i = 0; i < list->len; i++) {
+        if (is_word(list->items[i]))
+            block->sites[i] = stack_lookup(m, list_of1(list->items[i]), 1);
+        else if (!is_num(list->items[i]) && !is_list(list->items[i]))
+            return 0;
+    }
+    list->aot_owner = m;
+    list->aot_entry = block;
+    return 1;
+}
+
+int aot_bind_root(Machine *m, size_t index, const char *name, const char *kinds,
+                  int (*execute)(Machine *, AotBlock *, size_t)) {
+    Val word = from_word(as_list(str_list(name)));
+    Stack *s = stack_lookup(m, list_of1(word), 0);
+    return s && s->len && aot_bind(m, index, s->items[s->len - 1], kinds, execute);
+}
+
+int aot_bind_child(Machine *m, size_t index, size_t parent, size_t element, const char *kinds,
+                   int (*execute)(Machine *, AotBlock *, size_t)) {
+    if (parent >= m->aot_count || !m->aot_blocks[parent].definition) return 0;
+    List *list = as_list(m->aot_blocks[parent].definition);
+    if (element >= list->len || !aot_bind(m, index, list->items[element], kinds, execute)) return 0;
+    m->aot_blocks[index].nested = 1;
+    return 1;
+}
+
+int aot_generated_push(Machine *m, AotBlock *block, size_t index) {
+    if (m->aot_stats_enabled) m->aot_entries++;
+    data_push(m, as_list(block->definition)->items[index]);
+    return 0;
+}
+
+static int aot_run_block(Machine *m, AotBlock *block, size_t pc) {
+    m->aot_native_depth++;
+    if (m->aot_stats_enabled && m->aot_native_depth > m->aot_max_depth)
+        m->aot_max_depth = m->aot_native_depth;
+    int status = block->execute(m, block, pc);
+    m->aot_native_depth--;
+    return status;
+}
+
+int aot_generated_call(Machine *m, AotBlock *block, size_t index, size_t resume) {
+    if (m->aot_stats_enabled) m->aot_entries++;
+    m->ctl[m->ctl_len - 1].idx = resume;
+    Stack *site = block->sites[index];
+    if (site->len && is_list(site->items[site->len - 1])) {
+        Val definition = site->items[site->len - 1];
+        AotBlock *callee = aot_find(m, definition);
+        if (callee && as_list(definition)->len) {
+            if (m->aot_stats_enabled) {
+                callee->entries++;
+                if (callee->nested) m->aot_nested_entries++;
+            }
+            Frame *f = frame_push(m, FR_AOT_TRANSLATED);
+            f->a = definition;
+            f->b = (size_t)(callee - m->aot_blocks);
+            if (m->aot_native_depth >= 32) {
+                if (m->aot_stats_enabled) m->aot_depth_yields++;
+                return 1;
+            }
+            if (m->aot_stats_enabled) m->aot_direct_calls++;
+            int status = aot_run_block(m, callee, 0);
+            if (!status) m->ctl_len--;
+            return status;
+        }
+    }
+    if (m->aot_stats_enabled) m->aot_fallbacks++;
+    size_t depth = m->ctl_len;
+    Op op = {.st = block->sites[index], .v = as_list(block->definition)->items[index]};
+    if (site_slow(m, &op)) return -1;
+    return m->ctl_len != depth;
+}
