+#ifdef BO_AOT_BRIDGE
+int aot_bridge_install(Machine *m) {
+    Val step = from_word(as_list(str_list("BRIDGE-STEP")));
+    Val outer = from_word(as_list(str_list("BRIDGE-OUTER")));
+    Val grand = from_word(as_list(str_list("BRIDGE-GRAND")));
+    Val plus = from_word(as_list(str_list("+")));
+    Val add = from_word(as_list(str_list("ADD")));
+    Stack *s = stack_lookup(m, list_of1(step), 0);
+    Stack *o = stack_lookup(m, list_of1(outer), 0);
+    Stack *g = stack_lookup(m, list_of1(grand), 0);
+    m->bridge_plus = stack_lookup(m, list_of1(plus), 0);
+    m->bridge_add = stack_lookup(m, list_of1(add), 0);
+    if (!s || !s->len || !is_list(s->items[s->len - 1]) ||
+        !o || !o->len || !is_list(o->items[o->len - 1]) ||
+        !g || !g->len || !is_list(g->items[g->len - 1]) ||
+        !m->bridge_plus || !m->bridge_plus->len || !m->bridge_add) return 0;
+    Val definition = s->items[s->len - 1];
+    Val plus_definition = m->bridge_plus->items[m->bridge_plus->len - 1];
+    if (!is_list(plus_definition)) return 0;
+    List *body = as_list(definition), *wrapper = as_list(plus_definition);
+    List *outer_body = as_list(o->items[o->len - 1]), *grand_body = as_list(g->items[g->len - 1]);
+    if (body->len != 4 || body->items[0] != from_num(1) ||
+        !val_equal(body->items[1], plus) || body->items[2] != from_num(10) ||
+        !val_equal(body->items[3], plus) || wrapper->len != 2 ||
+        !is_list(wrapper->items[0]) || as_list(wrapper->items[0])->len ||
+        !val_equal(wrapper->items[1], add) ||
+        outer_body->len != 3 || !val_equal(outer_body->items[0], step) ||
+        outer_body->items[1] != from_num(100) || !val_equal(outer_body->items[2], plus) ||
+        grand_body->len != 3 || !val_equal(grand_body->items[0], outer) ||
+        grand_body->items[1] != from_num(1000) || !val_equal(grand_body->items[2], plus)) return 0;
+    m->bridge_definition = definition;
+    m->bridge_outer_definition = from_list(outer_body);
+    m->bridge_grand_definition = from_list(grand_body);
+    m->bridge_step = s;
+    m->bridge_outer = o;
+    m->bridge_plus_definition = plus_definition;
+    return 1;
+}
+
+static int aot_bridge_execute(Machine *m, Val definition, size_t pc) {
+    if (definition == m->bridge_definition) return aot_bridge_body(m, pc);
+    if (definition == m->bridge_outer_definition) return aot_bridge_outer_body(m, pc);
+    if (definition == m->bridge_grand_definition) return aot_bridge_grand_body(m, pc);
+    fputs("AOT bridge: invalid native frame\n", stderr);
+    exit(2);
+}
+
+int aot_bridge_call_nested(Machine *m, size_t target, size_t resume) {
+    Stack *stack;
+    Val definition;
+    if (target == 1) { stack = m->bridge_step; definition = m->bridge_definition; }
+    else if (target == 2) { stack = m->bridge_outer; definition = m->bridge_outer_definition; }
+    else { fputs("AOT bridge: invalid target\n", stderr); exit(2); }
+    m->ctl[m->ctl_len - 1].idx = resume;
+    if (stack->len && stack->items[stack->len - 1] == definition) {
+        Frame *child = frame_push(m, FR_AOT_BRIDGE);
+        child->a = definition;
+        m->bridge_direct_calls++;
+        int status = aot_bridge_execute(m, definition, 0);
+        if (!status) m->ctl_len--;
+        return status;
+    }
+    m->bridge_fallbacks++;
+    size_t depth = m->ctl_len;
+    Op op = {.st = stack, .v = as_list(stack->key)->items[0]};
+    if (site_slow(m, &op)) return -1;
+    return m->ctl_len != depth;
+}
+
+void aot_bridge_push(Machine *m, double number) {
+    push_num(m, number);
+}
+
+int aot_bridge_call_plus(Machine *m, size_t resume) {
+    Frame *frame = &m->ctl[m->ctl_len - 1];
+    frame->idx = resume;
+    Stack *plus = m->bridge_plus, *add = m->bridge_add;
+    if (plus->len && plus->items[plus->len - 1] == m->bridge_plus_definition &&
+        !add->len && add->native) {
+        data_push(m, as_list(m->bridge_plus_definition)->items[0]);
+        return call_native(m, add->native) ? -1 : 0;
+    }
+    m->bridge_fallbacks++;
+    size_t depth = m->ctl_len;
+    Op op = {.st = plus, .v = as_list(plus->key)->items[0]};
+    if (site_slow(m, &op)) return -1;
+    return m->ctl_len != depth;
+}
