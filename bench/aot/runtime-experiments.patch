+    Frame *f = &m->ctl[m->ctl_len - 1];
+    List *list = as_list(f->a);
+    LinkedOp *op = &list->linked->ops[index];
+    f->idx = index + 1;
+    if (m->linked_stats_enabled) {
+        m->linked_operations++;
+        m->linked_fragment_operations++;
+        if (op->transferred && m->linked_trace_word &&
+            val_equal(list->items[index], m->linked_trace_word))
+            m->linked_trace_operations++;
+    }
+    size_t depth = m->ctl_len;
+    int last = index + 1 == list->len;
+    int rc = word ? linked_word(m, op, list->items[index]) :
+                    linked_literal(m, op, list->items[index]);
+    if (rc) return -1;
+    return depth != m->ctl_len || (word && last);
+}
+
+int linked_fragment_literal(Machine *m, size_t index) {
+    return linked_fragment_step(m, index, 0);
+}
+int linked_fragment_word(Machine *m, size_t index) {
+    return linked_fragment_step(m, index, 1);
+}
+
+static const LinkedFragment *linked_full_fragment(List *list, size_t i, size_t *base) {
+    LinkedOp *op = &list->linked->ops[i];
+    const LinkedFragment *fragment = op->fragment;
+    if (!fragment || !op->full_fragment || i < op->fragment_index) return NULL;
+    *base = i - op->fragment_index;
+    return fragment;
+}
+
+static void linked_find_spans(List *list) {
+    for (size_t i = 0; i < list->len; i++) list->linked->ops[i].full_fragment = 0;
+    for (size_t i = 0; i < list->len; i++) {
+        LinkedOp *first = &list->linked->ops[i];
+        const LinkedFragment *fragment = first->fragment;
+        if (!fragment || first->fragment_index || fragment->len > list->len - i) continue;
+        size_t n = 0;
+        while (n < fragment->len) {
+            LinkedOp *part = &list->linked->ops[i + n];
+            if (part->fragment != fragment || part->fragment_origin != first->fragment_origin ||
+                part->fragment_index != n) break;
+            n++;
+        }
+        if (n == fragment->len) {
+            for (size_t k = 0; k < n; k++) list->linked->ops[i + k].full_fragment = 1;
+            i += n - 1;
+        }
+    }
+    list->linked->spans_ready = 1;
+}
+#endif
+
+static int linked_prepare(Machine *m, List *l) {
+    if (l->linked && l->linked->owner != m) return 0;
+    for (uint32_t i = 0; i < l->len; i++)
+        if (!is_word(l->items[i]) && !is_num(l->items[i]) && !is_list(l->items[i]))
+            return 0;
+    if (!l->linked) {
+        size_t bytes = sizeof(LinkedCode) + (size_t)l->len * sizeof(LinkedOp);
+        l->linked = calloc(1, bytes);
+        if (!l->linked) { fputs("linked experiment: out of memory\n", stderr); exit(2); }
+        l->linked->owner = m;
+        heap_alloc += bytes;
+    }
+#ifdef BO_LINKED_FRAGMENTS
+    const LinkedFragment *fragment = m->linked_fragments_enabled ? linked_fragment_for(l) : NULL;
+#endif
+    for (uint32_t i = 0; i < l->len; i++) {
+        LinkedOp *op = &l->linked->ops[i];
+        if (op->execute) continue;
+#ifdef BO_LINKED_FRAGMENTS
+        op->fragment = fragment;
+        op->fragment_origin = fragment ? l : NULL;
+        op->fragment_index = i;
+#endif
+        Val value = l->items[i];
+        if (is_word(value)) {
+            op->site = stack_lookup(m, list_of1(value), 1);
+            op->execute = linked_word;
+        } else {
+            op->execute = linked_literal;
+        }
+    }
+#ifdef BO_LINKED_FRAGMENTS
+    if (m->linked_fragments_enabled && !l->linked->spans_ready) linked_find_spans(l);
+#endif
+    return 1;
+}
+#endif
