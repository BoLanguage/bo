+        dest->linked->owner = source->linked->owner;
+        heap_alloc += bytes;
+    }
+    if (dest->linked->owner != source->linked->owner) return;
+#ifdef BO_LINKED_FRAGMENTS
+    dest->linked->spans_ready = 0;
+#endif
+    memcpy(dest->linked->ops + to, source->linked->ops + from, (size_t)count * sizeof(LinkedOp));
+    for (uint32_t i = 0; i < count; i++) {
+        if (!source->linked->ops[from + i].execute) continue;
+        dest->linked->transferred = 1;
+        dest->linked->ops[to + i].transferred = 1;
+        if (linked_count_enabled) linked_copy_count++;
+    }
+}
+#endif
